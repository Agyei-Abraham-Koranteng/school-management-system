# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# PREMIER SCHOOL MANAGEMENT SYSTEM SaaS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & MULTI-TENANCY
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"
APP_NAME="Premier University SIS"
DEFAULT_TENANT_SLUG="premier-university"
JWT_SECRET=""

# ------------------------------------------------------------------------------
# 2. SUPABASE RELATIONAL DATABASE & STORAGE (PostgreSQL)
# ------------------------------------------------------------------------------
# Client-safe credentials (publicly accessible by browser):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side ONLY administrative credentials (NEVER expose to frontend):
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL PROVIDER (Resend / SendGrid / Amazon SES)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="resend" # Options: resend | sendgrid | ses | smtp
EMAIL_FROM_ADDRESS="registry@premier.edu.gh"
EMAIL_FROM_NAME="Premier University Registry Directorate"
EMAIL_REPLY_TO="admissions@premier.edu.gh"

# Resend API Key
RESEND_API_KEY=""

# SendGrid API Key (if EMAIL_PROVIDER="sendgrid")
SENDGRID_API_KEY=""

# Amazon SES (if EMAIL_PROVIDER="ses")
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 4. WEB PUSH NOTIFICATIONS & FIREBASE CLOUD MESSAGING (FCM)
# ------------------------------------------------------------------------------
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sysadmin@premier.edu.gh"

# Firebase Cloud Messaging (if using FCM)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL SMS PROVIDER (Hubtel / Twilio / Arkesel - Ghana & Global)
# ------------------------------------------------------------------------------
SMS_PROVIDER="hubtel" # Options: hubtel | twilio | arkesel
SMS_SENDER_ID="PremierUniv" # 11-char institutional sender tag

# Hubtel Ghana API Credentials
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""

# Twilio Credentials (if SMS_PROVIDER="twilio")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 6. PAYMENT INFRASTRUCTURE & BURSARY (Paystack / Flutterwave / Hubtel MoMo)
# ------------------------------------------------------------------------------
PAYMENT_DEFAULT_GATEWAY="paystack" # Options: paystack | flutterwave | hubtel

# Paystack (Ghana, Nigeria, Kenya)
VITE_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Flutterwave (Africa & Pan-African diaspora)
VITE_FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# Hubtel Direct Mobile Money Checkout (MTN MoMo, Telecel Cash, AT Money)
HUBTEL_MERCHANT_ACCOUNT_NUMBER=""
HUBTEL_API_KEY=""

# ------------------------------------------------------------------------------
# 7. DOCUMENT ENCRYPTION & QR CREDENTIAL SIGNING
# ------------------------------------------------------------------------------
CREDENTIAL_SIGNING_SECRET=""
DOCUMENT_STORAGE_BUCKET="institutional-records-private"

# ------------------------------------------------------------------------------
# 8. ERROR MONITORING, SECURITY & OBSERVABILITY (Sentry)
# ------------------------------------------------------------------------------
VITE_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ENVIRONMENT="production"
LOG_LEVEL="info"

